# Server
PORT=3000

# Route prefix for all WorldView endpoints
WORLDVIEW_ROUTE_PREFIX=world-view

# OpenWeatherMap API key (for live wind data in CO2 model)
WORLDVIEW_OWM_KEY=

# Live weather polling interval in milliseconds (realtime wind analysis)
WORLDVIEW_WEATHER_INTERVAL=60000

# Path to KML file for map markers
WORLDVIEW_KML_PATH=data/locations.kml

# Local SQLite DB path (used when TURSO_DATABASE_URL is not set)
WORLDVIEW_DB_PATH=data/worldview.db

# Turso (serverless SQLite) — required for persistent pins on Vercel.
# Create a free database at https://turso.tech then:
#   turso db create worldview
#   turso db show worldview --url      -> TURSO_DATABASE_URL
#   turso db tokens create worldview   -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
