# Server
PORT=3000

# Route prefix for all WorldView endpoints
WORLDVIEW_ROUTE_PREFIX=world-view

# Rate limit: max requests per minute per IP
WORLDVIEW_RATE_LIMIT=30

# Aircraft tracking (OpenSky Network)
WORLDVIEW_AIRCRAFT_ENABLED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
WORLDVIEW_AIRCRAFT_INTERVAL=15000
WORLDVIEW_MAX_AIRCRAFT=1000

# OpenWeatherMap API key (for live wind data in CO2 model)
WORLDVIEW_OWM_KEY=

# Path to KML file for map markers
WORLDVIEW_KML_PATH=data/locations.kml
