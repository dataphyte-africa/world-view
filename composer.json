{
    "name": "world-view/core",
    "description": "Interactive world map with pins, heatmaps, KML layers, and optional aircraft tracking via OpenSky Network",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "WorldView\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WorldView\\WorldViewServiceProvider"
            ]
        },
        "oc-plugin-name": "Acme.WorldView"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    }
}
